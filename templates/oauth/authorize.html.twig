{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'sylius_admin_mcp_server.oauth.authorize.title'|trans({}, 'SyliusAdminMcpServer') }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-sm border-0" style="max-width: 480px; width: 100%;">

            <div class="card-header text-center border-0 pt-4 pb-0 bg-transparent">
                <h5 class="fw-bold mb-0">
                    {{ 'sylius_admin_mcp_server.oauth.authorize.title'|trans({}, 'SyliusAdminMcpServer') }}
                </h5>
            </div>

            <div class="card-body p-4">
                <p class="mb-3">
                    {{ 'sylius_admin_mcp_server.oauth.authorize.requesting_access'|trans({'%client_name%': client_name}, 'SyliusAdminMcpServer') }}
                </p>

                <div class="mb-4 d-flex align-items-center gap-2">
                    <span class="badge bg-primary">{{ scope }}</span>
                    <small class="text-muted">{{ 'sylius_admin_mcp_server.oauth.authorize.scope_label'|trans({}, 'SyliusAdminMcpServer') }}</small>
                </div>

                <p class="text-muted small mb-4">
                    {{ 'sylius_admin_mcp_server.oauth.authorize.signed_in_as'|trans({}, 'SyliusAdminMcpServer') }}:
                    <strong>{{ app.user.email }}</strong>
                </p>

                <form method="post" action="{{ path('sylius_admin_mcp_server_oauth_authorize') }}">
                    <input type="hidden" name="client_id" value="{{ client_id }}">
                    <input type="hidden" name="redirect_uri" value="{{ redirect_uri }}">
                    <input type="hidden" name="state" value="{{ state }}">
                    <input type="hidden" name="code_challenge" value="{{ code_challenge }}">
                    <input type="hidden" name="code_challenge_method" value="{{ code_challenge_method }}">
                    <input type="hidden" name="scope" value="{{ scope }}">
                    <input type="hidden" name="response_type" value="{{ response_type }}">

                    <div class="d-grid gap-2">
                        <button type="submit" name="approve" value="1" class="btn btn-primary">
                            {{ 'sylius_admin_mcp_server.oauth.authorize.allow'|trans({}, 'SyliusAdminMcpServer') }}
                        </button>
                        <button type="submit" name="approve" value="0" class="btn btn-outline-secondary">
                            {{ 'sylius_admin_mcp_server.oauth.authorize.deny'|trans({}, 'SyliusAdminMcpServer') }}
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
{% endblock %}
