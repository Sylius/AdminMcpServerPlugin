{
    "name": "sylius/admin-mcp-server-plugin",
    "type": "sylius-plugin",
    "description": "Sylius Admin MCP Server Plugin — exposes Sylius Admin API as an MCP server with OAuth 2.0 PKCE authentication.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mcp",
        "model-context-protocol",
        "ai",
        "oauth2"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "league/oauth2-server-bundle": "^1.2.2 || ^2.0",
        "nyholm/psr7": "^1.8",
        "sylius/sylius": "^2.1",
        "sylius/telemetry": "^1.0",
        "symfony/mcp-bundle": "^0.15"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.5",
        "sylius-labs/coding-standard": "^4.5",
        "sylius-labs/suite-tags-extension": "~0.3",
        "sylius/sylius-rector": "^3.9",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/type-info": "^7.4.24 || ^8.1.12",
        "symfony/webpack-encore-bundle": "^2.4"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        },
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\AdminMcpServerPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Sylius\\AdminMcpServerPlugin\\": ["tests/", "tests/TestApplication/src/"]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migrations:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
